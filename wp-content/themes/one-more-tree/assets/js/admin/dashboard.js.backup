    async loadContact() {
        let data = await this.api.fetchData('contact_submissions') || [];
        const render = () => {
            let trs = data.map((d, i) => `<tr><td class="px-4 py-2 border">${this.escapeHtml(d.date)}</td><td class="px-4 py-2 border">${this.escapeHtml(d.name)}</td><td class="px-4 py-2 border">${this.escapeHtml(d.email)}</td><td class="px-4 py-2 border">${this.escapeHtml(d.message)}</td><td class="px-4 py-2 border text-center"><button data-idx="${i}" class="del-btn text-xs text-red-600 px-2 py-1 bg-red-100 rounded">Delete</button></td></tr>`).join('');
            this.moduleContent.innerHTML = `<div class="space-y-6 animate-in fade-in"><h2 class="font-serif text-2xl font-bold flex justify-between">Contact Submissions <span class="bg-forest-100 text-forest-700 px-2 rounded-full text-sm">${data.length}</span></h2>
                <div class="overflow-x-auto bg-white rounded border border-earth-200"><table class="w-full text-sm"><thead class="bg-earth-50 text-left"><tr><th class="px-4 py-2 border">Date</th><th class="px-4 py-2 border">Name</th><th class="px-4 py-2 border">Email</th><th class="px-4 py-2 border">Message</th><th class="px-4 py-2 border text-center">Action</th></tr></thead><tbody>${trs}</tbody></table></div></div>`;
            document.querySelectorAll('.del-btn').forEach(btn => btn.addEventListener('click', async e => {
                data.splice(e.target.dataset.idx, 1);
                await this.api.saveData('contact_submissions', data);
                render();
            }));
        };
        render();
    }

    async loadNewsletter() {
        let data = await this.api.fetchData('newsletter_subscribers') || [];
        const render = () => {
            let trs = data.map((d, i) => `<tr><td class="px-4 py-2 border">${i+1}</td><td class="px-4 py-2 border">${this.escapeHtml(d.email)}</td><td class="px-4 py-2 border">${this.escapeHtml(d.date)}</td><td class="px-4 py-2 border">${this.escapeHtml(d.status)}</td><td class="px-4 py-2 border text-center"><button data-idx="${i}" class="del-btn text-xs text-red-600 px-2 py-1 bg-red-100 rounded">Delete</button></td></tr>`).join('');
            this.moduleContent.innerHTML = `<div class="space-y-6 animate-in fade-in"><h2 class="font-serif text-2xl font-bold flex justify-between">Newsletter <span class="bg-forest-100 text-forest-700 px-2 rounded-full text-sm">Total: ${data.length}</span></h2>
                <div class="flex gap-2 mb-4"><input id="ns-em" placeholder="Email" class="border px-4 py-2 rounded"><button id="add-ns" class="px-4 py-2 bg-forest-600 text-white rounded text-sm">Add</button></div>
                <div class="overflow-x-auto bg-white rounded border border-earth-200"><table class="w-full text-sm"><thead class="bg-earth-50 text-left"><tr><th class="px-4 py-2 border">#</th><th class="px-4 py-2 border">Email</th><th class="px-4 py-2 border">Date</th><th class="px-4 py-2 border">Status</th><th class="px-4 py-2 border text-center">Action</th></tr></thead><tbody>${trs}</tbody></table></div></div>`;
            document.getElementById('add-ns').addEventListener('click', async () => {
                let em = document.getElementById('ns-em').value;
                if(em) { data.push({email: em, date: new Date().toISOString().split('T')[0], status: 'Active'}); await this.api.saveData('newsletter_subscribers', data); render(); }
            });
            document.querySelectorAll('.del-btn').forEach(btn => btn.addEventListener('click', async e => {
                data.splice(e.target.dataset.idx, 1); await this.api.saveData('newsletter_subscribers', data); render();
            }));
        };
        render();
    }

    async loadModuleStatus() {
        let data = await this.api.fetchData('modules') || {};
        const toggles = ['home_hero', 'home_counters', 'home_story', 'home_donation', 'home_testimonials', 'live_map', 'impact_story', 'faq_section'];
        this.moduleContent.innerHTML = `<div class="space-y-6 animate-in fade-in"><h2 class="font-serif text-2xl font-bold">Module Visibility</h2>
            <div class="grid gap-4 sm:grid-cols-2">${toggles.map(t => this.checkboxInput(`mod-${t}`, t, data[t])).join('')}</div>
            <div class="flex justify-end"><button id="sv" class="px-6 py-2.5 bg-forest-600 text-white rounded-full text-sm">Save</button></div><div id="tst"></div></div>`;
        document.getElementById('sv').addEventListener('click', async () => {
            toggles.forEach(t => data[t] = document.getElementById(`mod-${t}`).checked);
            const res = await this.api.saveData('modules', data);
            this.api.showToast('tst', res.ok?'Saved':'Error', res.ok);
        });
    }

    async loadBlog() {
        let data = await this.api.fetchData('blog_settings') || {};
        this.moduleContent.innerHTML = `<div class="space-y-6 animate-in fade-in"><h2 class="font-serif text-2xl font-bold">Blog Settings</h2>
            <div class="space-y-4">
                ${this.checkboxInput('b-rp', 'Reading Progress Bar', data.reading_progress_bar)}
                ${this.checkboxInput('b-toc', 'TOC Enabled', data.toc_enabled)}
                ${this.checkboxInput('b-ss', 'Social Share', data.social_share)}
                ${this.textareaInput('b-da', 'Default Author Bio', data.default_author_bio)}
            </div>
            <div class="flex justify-end"><button id="sv" class="px-6 py-2.5 bg-forest-600 text-white rounded-full text-sm">Save</button></div><div id="tst"></div></div>`;
        document.getElementById('sv').addEventListener('click', async () => {
            data.reading_progress_bar = document.getElementById('b-rp').checked;
            data.toc_enabled = document.getElementById('b-toc').checked;
            data.social_share = document.getElementById('b-ss').checked;
            data.default_author_bio = document.getElementById('b-da').value;
            const res = await this.api.saveData('blog_settings', data);
            this.api.showToast('tst', res.ok?'Saved':'Error', res.ok);
        });
    }

    async loadAdminUsers() {
        this.moduleContent.innerHTML = `<div class="space-y-6 animate-in fade-in"><h2 class="font-serif text-2xl font-bold">Admin Users</h2>
            <div class="p-4 bg-white rounded-2xl border border-earth-200">
                <p class="mb-4">User management is handled via WordPress Dashboard → Users. <a href="/wp-admin/users.php" class="text-forest-600 underline">Click here → [link]</a></p>
                <div class="p-4 bg-earth-50 rounded"><strong>Current User:</strong> ${this.escapeHtml(this.config?.user?.name || 'Admin')}</div>
            </div></div>`;
    }

    async loadReporting() {
        let contacts = await this.api.fetchData('contact_submissions') || [];
        let newsletter = await this.api.fetchData('newsletter_subscribers') || [];
        let projects = await this.api.fetchData('projects') || {items:[]};
        let counters = await this.api.fetchData('home_counters') || {treesTracked:0};
        
        this.moduleContent.innerHTML = `<div class="space-y-6 animate-in fade-in"><h2 class="font-serif text-2xl font-bold">Reporting Summary</h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <div class="p-4 bg-white rounded-2xl border border-earth-200 text-center"><h3 class="text-3xl font-bold text-forest-600">${contacts.length}</h3><p class="text-sm text-foreground/60">Contact Submissions</p></div>
                <div class="p-4 bg-white rounded-2xl border border-earth-200 text-center"><h3 class="text-3xl font-bold text-forest-600">${newsletter.length}</h3><p class="text-sm text-foreground/60">Subscribers</p></div>
                <div class="p-4 bg-white rounded-2xl border border-earth-200 text-center"><h3 class="text-3xl font-bold text-forest-600">${(projects.items || []).length}</h3><p class="text-sm text-foreground/60">Active Projects</p></div>
                <div class="p-4 bg-white rounded-2xl border border-earth-200 text-center"><h3 class="text-3xl font-bold text-forest-600">${counters.treesTracked}</h3><p class="text-sm text-foreground/60">Trees Tracked</p></div>
            </div></div>`;
    }
}
