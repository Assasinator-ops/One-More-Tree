    async loadFooterContent() {
        let data = await this.api.fetchData('footer') || {tagline:'', copyright:'', policy_links:[]};
        if(!data.policy_links) data.policy_links = [];
        const render = () => {
            let lHtml = data.policy_links.map((l, i) => `
                <div class="flex gap-2 mb-2"><input id="f-pl-l-${i}" value="${this.escapeHtml(l.label)}" placeholder="Label" class="border px-2 py-1 rounded w-1/2">
                <input id="f-pl-u-${i}" value="${this.escapeHtml(l.url)}" placeholder="URL" class="border px-2 py-1 rounded w-1/2">
                <button data-idx="${i}" class="del-btn text-xs text-red-600">Del</button></div>
            `).join('');
            this.moduleContent.innerHTML = `<div class="space-y-6 animate-in fade-in"><h2 class="font-serif text-2xl font-bold">Footer Content</h2>
                ${this.textInput('f-t', 'Tagline', data.tagline)} ${this.textInput('f-c', 'Copyright', data.copyright)}
                <div class="p-4 bg-white rounded-2xl border border-earth-200"><h3 class="font-bold flex justify-between">Policy Links <button id="add-l" class="text-xs text-forest-600">+ Add</button></h3>
                <div class="mt-2">${lHtml}</div></div>
                <div class="flex justify-end"><button id="sv" class="px-6 py-2.5 bg-forest-600 text-white rounded-full text-sm">Save</button></div><div id="tst"></div></div>`;
            const sync = () => {
                data.tagline = document.getElementById('f-t').value; data.copyright = document.getElementById('f-c').value;
                data.policy_links = data.policy_links.map((_, i) => ({label: document.getElementById(`f-pl-l-${i}`).value, url: document.getElementById(`f-pl-u-${i}`).value}));
            };
            document.getElementById('add-l').addEventListener('click', () => { sync(); data.policy_links.push({}); render(); });
            document.querySelectorAll('.del-btn').forEach(btn => btn.addEventListener('click', e => { sync(); data.policy_links.splice(e.target.dataset.idx, 1); render(); }));
            document.getElementById('sv').addEventListener('click', async () => { sync(); const res = await this.api.saveData('footer', data); this.api.showToast('tst', res.ok?'Saved':'Error', res.ok); });
        };
        render();
    }

    async loadVolunteerPage() {
        let data = await this.api.fetchData('volunteer_page') || {cards:Array(3).fill({})};
        if(!data.cards || data.cards.length !== 3) data.cards = Array(3).fill({});
        const fields = ['hero_badge', 'hero_title', 'hero_subtitle', 'form_title', 'form_subtitle', 'interest_options'];
        const render = () => {
            let cHtml = data.cards.map((c, i) => `
                <div class="p-2 border rounded">
                    <input id="vp-c-i-${i}" value="${this.escapeHtml(c.icon)}" placeholder="Icon" class="w-full border px-1 mb-1">
                    <input id="vp-c-t-${i}" value="${this.escapeHtml(c.title)}" placeholder="Title" class="w-full border px-1 mb-1">
                    <textarea id="vp-c-d-${i}" placeholder="Desc" class="w-full border px-1">${this.escapeHtml(c.desc)}</textarea>
                </div>
            `).join('');
            this.moduleContent.innerHTML = `<div class="space-y-6 animate-in fade-in"><h2 class="font-serif text-2xl font-bold">Volunteer Page</h2>
                <div class="grid gap-4 sm:grid-cols-2">${fields.map(f => f==='interest_options' ? this.textareaInput(f, f, data[f]) : this.textInput(f, f, data[f])).join('')}</div>
                <h3 class="font-bold">3 Info Cards</h3><div class="grid gap-4 sm:grid-cols-3">${cHtml}</div>
                <div class="flex justify-end"><button id="sv" class="px-6 py-2.5 bg-forest-600 text-white rounded-full text-sm">Save</button></div><div id="tst"></div></div>`;
            document.getElementById('sv').addEventListener('click', async () => {
                fields.forEach(f => data[f] = document.getElementById(f).value);
                data.cards = [0,1,2].map(i => ({icon: document.getElementById(`vp-c-i-${i}`).value, title: document.getElementById(`vp-c-t-${i}`).value, desc: document.getElementById(`vp-c-d-${i}`).value}));
                const res = await this.api.saveData('volunteer_page', data);
                this.api.showToast('tst', res.ok?'Saved':'Error', res.ok);
            });
        };
        render();
    }

