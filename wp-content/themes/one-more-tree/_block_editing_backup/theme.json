{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "customTemplates": [
    {
      "name": "page-home",
      "title": "Home Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-about",
      "title": "About Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-projects",
      "title": "Projects Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-contact",
      "title": "Contact Page",
      "postTypes": ["page"]
    },
    {
      "name": "single-post",
      "title": "Single Post",
      "postTypes": ["post"]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer", 
      "area": "footer"
    },
    {
      "name": "sidebar",
      "title": "Sidebar",
      "area": "uncategorized"
    },
    {
      "name": "comments",
      "title": "Comments",
      "area": "uncategorized"
    }
  ],
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1280px"
    },
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultGradients": true,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "forest-50",
          "color": "#f0fdf4",
          "name": "Forest 50"
        },
        {
          "slug": "forest-100",
          "color": "#dcfce7",
          "name": "Forest 100"
        },
        {
          "slug": "forest-200",
          "color": "#bbf7d0",
          "name": "Forest 200"
        },
        {
          "slug": "forest-500",
          "color": "#22c55e",
          "name": "Forest 500"
        },
        {
          "slug": "forest-600",
          "color": "#16a34a",
          "name": "Forest 600"
        },
        {
          "slug": "forest-700",
          "color": "#15803d",
          "name": "Forest 700"
        },
        {
          "slug": "forest-800",
          "color": "#166534",
          "name": "Forest 800"
        },
        {
          "slug": "forest-900",
          "color": "#14532d",
          "name": "Forest 900"
        },
        {
          "slug": "forest-950",
          "color": "#052e16",
          "name": "Forest 950"
        },
        {
          "slug": "emerald-400",
          "color": "#34d399",
          "name": "Emerald 400"
        },
        {
          "slug": "emerald-500",
          "color": "#10b981",
          "name": "Emerald 500"
        },
        {
          "slug": "forest-400",
          "color": "#4ade80",
          "name": "Forest 400"
        },
        {
          "slug": "slate-200",
          "color": "#e2e8f0",
          "name": "Slate 200"
        },
        {
          "slug": "earth-100",
          "color": "#f1f5f9",
          "name": "Earth 100"
        },
        {
          "slug": "earth-200",
          "color": "#e2e8f0",
          "name": "Earth 200"
        },
        {
          "slug": "earth-300",
          "color": "#cbd5e1",
          "name": "Earth 300"
        },
        {
          "slug": "earth-800",
          "color": "#1e293b",
          "name": "Earth 800"
        },
        {
          "slug": "background",
          "color": "#f8fafc",
          "name": "Background"
        },
        {
          "slug": "foreground",
          "color": "#0f172a",
          "name": "Foreground"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Black"
        }
      ],
      "gradients": [
        {
          "slug": "forest-gradient",
          "gradient": "linear-gradient(135deg, #15803d 0%, #16a34a 50%, #059669 100%)",
          "name": "Forest Gradient"
        },
        {
          "slug": "hero-soft-gradient",
          "gradient": "linear-gradient(180deg, #f0fdf4 0%, #f8fafc 100%)",
          "name": "Hero Soft Gradient"
        },
        {
          "slug": "dark-forest-gradient",
          "gradient": "linear-gradient(135deg, #022c22 0%, #0f172a 100%)",
          "name": "Dark Forest Gradient"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true,
      "dropCap": true,
      "fontFamilies": [
        {
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "inter",
          "name": "Inter (Sans-Serif)"
        },
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "slug": "playfair",
          "name": "Playfair Display (Serif)"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.75rem",
          "name": "Extra Small"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "normal",
          "size": "1rem",
          "name": "Normal"
        },
        {
          "slug": "medium",
          "size": "1.125rem",
          "name": "Medium"
        },
        {
          "slug": "lg",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "1.5rem",
          "name": "Extra Large"
        },
        {
          "slug": "2xl",
          "size": "1.875rem",
          "name": "2X Large"
        },
        {
          "slug": "3xl",
          "size": "2.25rem",
          "name": "3X Large"
        },
        {
          "slug": "4xl",
          "size": "3rem",
          "name": "4X Large"
        }
      ]
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "minHeight": true
    },
    "position": {
      "sticky": true
    },
    "shadow": {
      "presets": [
        {
          "name": "Soft",
          "slug": "soft",
          "shadow": "0 1px 2px 0 rgb(0 0 0 / 0.05)"
        },
        {
          "name": "Medium",
          "slug": "medium", 
          "shadow": "0 4px 6px -1px rgb(0 0 0 / 0.1)"
        },
        {
          "name": "Elevated",
          "slug": "elevated",
          "shadow": "0 10px 15px -3px rgb(0 0 0 / 0.1)"
        }
      ]
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--normal)",
      "lineHeight": "1.7"
    },
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4xl)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--forest-700)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--forest-800)"
          }
        }
      },
      "button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "600"
        },
        "color": {
          "background": "var(--wp--preset--color--forest-700)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "9999px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  }
}
